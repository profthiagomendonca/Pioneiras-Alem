[node name="AboutText" type="RichTextLabel" parent="AboutModal/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.88, 0.9, 0.95, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "[b]Pioneiras & Além[/b] é um jogo sério e educativo concebido para evidenciar o protagonismo e as contribuições essenciais de mulheres na ciência da computação.

[b]As 6 Pioneiras do Jogo:[/b]
1. [color=#ffc107]Ada Lovelace (1843):[/color] Primeiro Algoritmo da história.
2. [color=#ef5350]ENIAC Girls (1945):[/color] Primeira programação física de computador eletrônico.
3. [color=#4fc3f7]Grace Hopper (1947):[/color] Primeiro bug documentado e criação dos compiladores.
4. [color=#81c784]Katherine Johnson (1962):[/color] Cálculos orbitais cruciais para a NASA.
5. [color=#ba68c8]Mary Kenneth Keller (1965):[/color] Primeiro Ph.D. em TI e pioneira do BASIC educacional.
6. [color=#ff8a65]Margaret Hamilton (1969):[/color] Criação da Engenharia de Software e o pouso na Lua.

[b]Alinhamento aos ODS:[/b] ODS 05 (Igualdade de Gênero) e ODS 04 (Educação de Qualidade)."

